# Copy to .env.local for local dev. Set the same values in Vercel → Settings → Environment Variables.
# ── Server only (secret) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
OLA_MAPS_API_KEY=
# ── Browser (public; the Ola key must be domain-whitelisted in Krutrim Cloud) ──
VITE_OLA_MAPS_API_KEY=
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
